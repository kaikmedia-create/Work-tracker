]).digest('hex'),'21acc06cc9821adabd378b1148df512db35f8255994648dc988b6a6b49d7a96b','historical v12 source: worker.js');assert.equal(createHash('sha256').update(r.files()['public/style.css']).digest('hex'),'1155f9e9cd795c2d6f331e87498292f2ae2b02675c115955631a8e18f482ed9c','historical v12 source: style.css');assert(h.includes('mapScale'));assert(h.includes('GALICIA'));assert(h.includes('markerLimit'));assert(h.includes('Format &amp; Weißraum'));assert(h.includes('window.RELIEF_STATIC_PREVIEW=true'));assert(!h.includes('<script src=\"core.js\">'));assert(h.includes('function buildArchitecture'));assert(h.includes(\"RS_WORKER_SOURCE\"));assert(!h.includes(\"importScripts('core.js','architecture.js');\"));await mkdir(join(root,'reports/v12'),{recursive:true});await writeFile(join(root,'reports/v12/gate-rendered.html'),h);assert(h.length>180000);});"]]]},"tests/v13_gate.test.mjs":{"base":"e9b41a5f9a344b39c1516ca82c94d81c9dbab3ae2794858fcf3005ca85e69f43","result":"8fe6c74552ab6cfd4fa70c8ff11482c423c854e5deb2517b83cf64c52fd0a093","edits":[[16,1,["test('v13 index loads the current preview gate',()=>assert.match(entry,/gate-v21\\.js\\?v=21/));"]]]},"tests/v14_gate.test.mjs":{"base":"971f08fadebc547392d8fa4a7b010c43098104f755daba8f68536c7faafcffbc","result":"d1e9a228721da1bcd7183043246fe536a61f71bbe7d4e4f486a623081728c6fe","edits":[[13,1,["test('v14 remains available while v15 is the published entry',async()=>assert((await readFile(join(site,'index.html'),'utf8')).includes('gate-v21.js?v=21')));"]]]},"tests/v15_gate.test.mjs":{"base":"b14d30446d8d20b8eed905332c7c4423289018a679fe686367776cee20bd8b32","result":"d8dd5a713420b0e07cfdc37f3fe673974df900e64a1dbd468b11614923dc2bff","edits":[[13,1,["test('v15 remains available while v15 is the published entry',async()=>assert((await readFile(join(site,'index.html'),'utf8')).includes('gate-v21.js?v=21')));"]],[22,1,["  else if(key==='public/viewer.js')assert.equal(createHash('sha256').update(r.files()[key]).digest('hex'),'c644aef7b7a4a