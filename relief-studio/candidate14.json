{"version":14,"changes":{"public/architecture.js":{"base":"b2786237c74b557777f85a36cb086a88e4c25e11ec67127d47e577cdf677df90","result":"91c82c9ac24b9587a71522f01a1856fc1c238f0b4966e1d320976e9555600cd0","edits":[[21,0,[" // Distances must be independent of the cutter edge length. A fixed epsilon"," // on the unnormalised cross product gives short OSM edges a huge fuzzy band."," // Two complementary clips then overlap instead of partitioning the surface."," const length=Math.hypot(line[0],line[1]);"," if(length===0)return line[2]>=0?poly:[];"," const unit=line.map(v=>v/length),distance=p=>{const d=evalZ(unit,p);return Math.abs(d)<=EPS?0:d;};"]],[22,1,["  const a=poly[i],b=poly[(i+1)%poly.length],da=distance(a),db=distance(b),ia=da>=0,ib=db>=0;"]],[236,2,[" }"," // Rounding at a shared seam can leave a microscopic A-B-A spur. Cancel it"," // within its OWN face before registering adjacency, never hide other faces."," for(let fi=0;fi<faces.length;fi++){","  const f=faces[fi],ids=[];","  for(const id of f.edgeSegments.flatMap(e=>e.ids.slice(0,-1))){","   if(id===ids.at(-1))continue;","   if(ids.length>1&&id===ids.at(-2)){ids.pop();continue;}","   ids.push(id);"]],[239,1,["  let changed=true;while(changed&&ids.length>2){changed=false;","   if(ids[0]===ids.at(-1)){ids.pop();changed=true;}","   else if(ids[1]===ids.at(-1)){ids.shift();ids.pop();changed=true;}","   else if(ids[0]===ids.at(-2)){ids.pop();ids.pop();changed=true;}","  }","  f.ids=ids;","  if(ids.length<3||Math.abs(area(ids.map(id=>xy[id])))<EPS*EPS){f.ids=[];continue;}","  for(let j=0;j<ids.length;j++){","   const a=ids[j],b=ids[(j+1)%ids.length],key=a<b?a+','+b:b+','+a;","   if(!edges.has(key))edges.set(key,[]);edges.get(key).push({a,b,f:fi});","   xyZ[a].push(evalZ(f.plane,xy[a]));","  }"]],[241,0,[""]],[255,1,["  const ids=f.ids;if(ids.length<3)continue;"]]]}}}